# NTRIP Caster 环境变量示例
# 复制为 .env 使用：cp .env.example .env
#
# 说明：这些变量会覆盖 config.ini 中的同名配置。
# 实际由程序读取的环境变量见 src/config.py：
#   NTRIP_CONFIG_FILE, DATABASE_PATH, LOG_DIR, DATA_DIR,
#   NTRIP_HOST, NTRIP_PORT, WEB_HOST, WEB_PORT, SECRET_KEY, DEBUG,
#   DEMO_MODE, PUBLIC_ACCESS,
#   MAX_WEB_PARSERS, PARSER_CLIENT_TTL, PARSER_GRACE_SECONDS, PARSER_IP_RATE,
#   EXTERNAL_*（外部 Caster 拉取与中继，共 28 项，见下方专节）

# ================================
# 应用
# ================================
APP_VERSION=2.3.8

# ================================
# 端口 / 监听地址
# ================================
# NTRIP_HOST 只影响 NTRIP（2101）的监听地址，
# WEB_HOST 只影响 Web（5757）的监听地址；不填则跟随 config.ini 的 [network] host。
NTRIP_HOST=0.0.0.0
NTRIP_PORT=2101
WEB_HOST=0.0.0.0
WEB_PORT=5757

# ================================
# 数据库 / 日志 / 数据目录（容器内请用 /app/... 并挂卷）
# ================================
DATABASE_PATH=2rtk.db
LOG_DIR=logs
DATA_DIR=data

# ================================
# 安全
# ================================
# 留空则首次启动自动生成随机密钥并落盘 data/.secret_key
SECRET_KEY=

# ================================
# 调试
# ================================
DEBUG=false

# ================================
# 演示模式（对外公开的测试站才开）
# ================================
# 1/true = 开启：登录后台只能新增用户/挂载点、启停解析，
#          改、删、改密码、重启一律 403。
# 也可以直接改 config.ini 的 [security] demo_mode。
DEMO_MODE=false

# ================================
# 数据页公开（未登录也能看实时数据）
# ================================
# 1/true = 开启：未登录访客可看「总览 / 实时数据」并自行发起解析，
#          走 /api/public/，用户明细与源站 IP 不下发。
# 也可以直接改 config.ini 的 [web] public_access。
PUBLIC_ACCESS=false

# ================================
# 实时解析并发（演示站务必按机器配置调低）
# ================================
# 同一挂载点多人看只跑 1 个线程；这里只限制「同时被解析的挂载点个数」。
# 也可以直接改 config.ini 的 [web] 段（max_web_parsers 等）。
MAX_WEB_PARSERS=4
# 心跳超时（秒）：超时未收到心跳自动退订
PARSER_CLIENT_TTL=45
# 订阅归零后的宽限期（秒）
PARSER_GRACE_SECONDS=5
# 单 IP 每分钟最多发起几次解析（0 = 不限）
PARSER_IP_RATE=10

# ================================
# 外部 Caster 拉取与中继
# ================================
# 测试服务器：EXTERNAL_CASTER_ENABLED=true / EXTERNAL_CASTER_UI_ENABLED=false
#   （后端照常拉表与 relay，前端完全不显示配置入口；用 API 配置）
# 正式服务器：两项都 true，管理员登录后在设置页配置。
# 注意：这里用三态解析，显式 false 可以覆盖 config.ini 里的 true。
EXTERNAL_CASTER_ENABLED=false
EXTERNAL_CASTER_UI_ENABLED=false
# STR 刷新：6h 常规周期 + 失败退避（防上游按 IP 封禁）+ 按需刷新护栏
EXTERNAL_STR_REFRESH=21600
EXTERNAL_STR_BACKOFF_MAX=86400
EXTERNAL_STR_JITTER=0.10
EXTERNAL_STR_DEMAND_COOLDOWN=900
EXTERNAL_STR_NEGATIVE_TTL=600
# 连接与 relay 限额
EXTERNAL_CONNECT_TIMEOUT=5
EXTERNAL_READ_TIMEOUT=20
EXTERNAL_MAX_RELAYS=8
EXTERNAL_MAX_RELAYS_PER_SOURCE=4
EXTERNAL_MAX_SUBSCRIBERS_PER_MOUNT=200
EXTERNAL_RELAY_GRACE=5
EXTERNAL_RELAY_IDLE=60
EXTERNAL_MAX_STR_BYTES=4194304
# 账号池（默认开）
EXTERNAL_ACCOUNT_POOL=true
EXTERNAL_ACCOUNT_LEASE_TTL=60
# GGA 转发（默认关）
EXTERNAL_GGA_FORWARD=false
EXTERNAL_GGA_INTERVAL=1
EXTERNAL_GGA_MAX_LINE=256
EXTERNAL_GGA_RATE_LIMIT=10
EXTERNAL_LOCATION_SHARE=false
EXTERNAL_LOCATION_RADIUS_M=30000
# 出站 agent 标识池
EXTERNAL_UA_POOL_ENABLED=true
EXTERNAL_UA_PROFILE_FILE=src/data/ntrip_agent_profiles.json
# per_account / per_connection / sticky_source
EXTERNAL_UA_ROTATION=per_account
EXTERNAL_UA_BLOCK_COOLDOWN=3600
EXTERNAL_UA_ALLOW_BROWSER=false

# ================================
# 时区
# ================================
TZ=Asia/Shanghai

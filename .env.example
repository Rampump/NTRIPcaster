# NTRIP Caster 环境变量示例
# 复制为 .env 使用：cp .env.example .env
#
# 说明：这些变量会覆盖 config.ini 中的同名配置。
# 实际由程序读取的环境变量见 src/config.py：
#   NTRIP_CONFIG_FILE, DATABASE_PATH, LOG_DIR, DATA_DIR,
#   NTRIP_HOST, NTRIP_PORT, WEB_PORT, SECRET_KEY, DEBUG

# ================================
# 应用
# ================================
APP_VERSION=2.3.2

# ================================
# 端口
# ================================
NTRIP_HOST=0.0.0.0
NTRIP_PORT=2101
WEB_HOST=0.0.0.0
WEB_PORT=5757

# ================================
# 数据库 / 日志 / 数据目录（容器内请用 /app/... 并挂卷）
# ================================
DATABASE_PATH=2rtk.db
LOG_DIR=logs
DATA_DIR=data

# ================================
# 安全
# ================================
# 留空则首次启动自动生成随机密钥并落盘 data/.secret_key
SECRET_KEY=

# ================================
# 调试
# ================================
DEBUG=false

# ================================
# 时区
# ================================
TZ=Asia/Shanghai
